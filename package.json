{
  "name": "shisha-search",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build:data": "tsx scripts/build-data.ts",
    "picks:candidates": "tsx scripts/list-imaged-flavors.ts",
    "dev": "pnpm run build:data && next dev",
    "prebuild": "npx tsx scripts/build/generate-flavor-image-map.ts",
    "build": "pnpm run build:data && next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm run build:data && tsc --noEmit",
    "test": "pnpm run build:data && vitest run",
    "test:watch": "pnpm run build:data && vitest",
    "test:ci": "pnpm run build:data && vitest run --coverage",
    "preview": "pnpm run build:data && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "pnpm run build:data && opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@next/third-parties": "^16.4.3",
    "@sentry/browser": "^11.10.0",
    "@sentry/cloudflare": "^11.10.0",
    "@sentry/nextjs": "^11.10.0",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@opennextjs/cloudflare": "^1.20.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vitest-fetch-mock": "^0.4.5",
    "wrangler": "^4.156.0"
  }
}
